# 统一换行，避免 Windows 的 CRLF 让整文件产生 diff
* text=auto eol=lf

*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf

# 二进制文件不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
